# Godot 4+ specific ignores
.godot/
.import/
*.import

/android/


# Model imports are committed: they carry required animation settings
# (key optimizer disabled, 30 fps bake) that Godot defaults would degrade
!assets/npcs/models/*.glb.import
!assets/monsters/models/*.glb.import
!assets/avatars/base/*.glb.import
